{
  "name": "audiolab-studio",
  "productName": "AudioLab Pro",
  "version": "0.311.0",
  "description": "AudioLab Pro - a Digital Audio Workstation",
  "author": "Audio-lab-DAW",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "sync": "node scripts/sync-app.js",
    "start": "npm run sync && electron .",
    "dist:mac": "npm run sync && electron-builder --mac --arm64 --publish never",
    "dist:win": "npm run sync && electron-builder --win --x64 --publish never",
    "release:mac": "npm run sync && electron-builder --mac --arm64 --publish always",
    "release:win": "npm run sync && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "onnxruntime-node": "1.31.1"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.audiolab.studio",
    "productName": "AudioLab Pro",
    "copyright": "AudioLab Pro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "dock-icon.png",
      "icon-assets/picker/*.png",
      "icon-assets/picker/icons.json",
      "icon-assets/picker/thumb/*.png",
      "icon-assets/picker/small/*.png",
      "app/**/*",
      "package.json",
      "voice-ai.js",
      "voice-ai-worker.js",
      "native-engine.js",
      "native-feeder.js",
      "lt-midi.js"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Audio-lab-DAW",
        "repo": "Audio-Lab-Beta",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "CFBundleIconName": "AppIcon",
        "NSMicrophoneUsageDescription": "AudioLab Pro needs audio input access to record and to list your audio output devices.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "AudioLab Pro project",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.audiolab.project"
            ],
            "CFBundleTypeExtensions": [
              "audiolab"
            ],
            "CFBundleTypeIconFile": "doc.icns"
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.audiolab.project",
            "UTTypeDescription": "AudioLab Pro project",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeIconFile": "doc.icns",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "audiolab"
              ]
            }
          }
        ]
      },
      "extraResources": [
        {
          "from": "bin/alvol",
          "to": "bin/alvol"
        },
        {
          "from": "build/doc.icns",
          "to": "doc.icns"
        },
        {
          "from": "build/Assets.car",
          "to": "Assets.car"
        }
      ],
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/x64/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/arm64/libonnxruntime.1.*.*.dylib"
      ]
    },
    "dmg": {
      "title": "AudioLab Pro ${version}",
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "fileAssociations": [
        {
          "ext": "audiolab",
          "name": "AudioLab Pro project",
          "description": "AudioLab Pro project",
          "role": "Editor",
          "icon": "build/doc"
        }
      ],
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
      ],
      "extraResources": [
        {
          "from": "build/icon.ico",
          "to": "icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "afterPack": "scripts/afterPack.js",
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**"
    ]
  }
}
