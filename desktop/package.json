{
  "name": "audiolab-studio",
  "productName": "AudioLab Studio",
  "version": "0.158.0",
  "description": "AudioLab Studio - a Digital Audio Workstation",
  "author": "Audio-lab-DAW",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "sync": "node scripts/sync-app.js",
    "start": "npm run sync && electron .",
    "dist:mac": "npm run sync && electron-builder --mac --arm64 --publish never",
    "dist:win": "npm run sync && electron-builder --win --x64 --publish never",
    "release:mac": "npm run sync && electron-builder --mac --arm64 --publish always",
    "release:win": "npm run sync && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.audiolab.studio",
    "productName": "AudioLab Studio",
    "copyright": "AudioLab Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "dock-icon.png",
      "app/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Audio-lab-DAW",
        "repo": "Audio-Lab-Beta",
        "releaseType": "release"
      }
    ],
    "fileAssociations": [
      {
        "ext": "audiolab",
        "name": "AudioLab Studio project",
        "description": "AudioLab Studio project",
        "role": "Editor",
        "icon": "build/doc"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "AudioLab Studio needs audio input access to record and to list your audio output devices."
      },
      "extraResources": [
        {
          "from": "bin/alvol",
          "to": "bin/alvol"
        }
      ]
    },
    "dmg": {
      "title": "AudioLab Studio ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "afterPack": "scripts/afterPack.js"
  }
}
